# Copy to backend/.env and fill in. Never commit the real .env.
ENV=development
PORT=8000
DATABASE_URL=sqlite:///./trace.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Required in production: at least 32 random characters
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATA_DIR=./data/uploads
# Optional: raises the GitHub API rate limit for imports
GITHUB_TOKEN=
# Optional: password reset only works when all four are set
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
VITE_API_URL=
